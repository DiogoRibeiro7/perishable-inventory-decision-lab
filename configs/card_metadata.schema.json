{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Card metadata",
  "type": "object",
  "required": [
    "card_type",
    "card_version",
    "package_version",
    "owner",
    "reviewed_at",
    "artifact_versions",
    "metrics",
    "claims",
    "assumptions",
    "interface_names"
  ],
  "properties": {
    "card_type": {
      "enum": ["model", "policy", "simulator", "system"]
    },
    "card_version": {
      "type": "string"
    },
    "package_version": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "artifact_versions": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "artifact_path", "artifact_field"],
        "properties": {
          "name": {"type": "string"},
          "artifact_path": {"type": "string"},
          "artifact_field": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "evidence_type", "reference"],
        "properties": {
          "claim": {"type": "string"},
          "evidence_type": {"enum": ["test", "report", "artifact", "assumption"]},
          "reference": {"type": "string"}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "interface_names": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    }
  }
}
